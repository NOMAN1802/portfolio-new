# Copy to .env for local setup. Never commit .env or real secrets.
# Vercel: configure Preview/Production values in Project Settings.
# NODE_ENV and PORT below are local-only; let Vercel manage its runtime.
NODE_ENV=development
PORT=5000
APP_URL=http://127.0.0.1:5000
# On Vercel use the matching deployment URL or final production domain.

# MongoDB: use a dedicated development database.
DB_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/emonDB
BCRYPT_SALT_ROUNDS=12

# Generate independent, high-entropy secrets before implementation runs.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# Portfolio images and optional public resume PDF.
# Upload directly to Cloudinary with server-issued restricted signatures.
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_API_KEY
CLOUDINARY_API_SECRET=REPLACE_API_SECRET
CLOUDINARY_UPLOAD_PRESET=emon_portfolio_signed
UPLOAD_MAX_BYTES=10485760

# SMTP: sender credentials remain server-only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SENDER_EMAIL=REPLACE_SENDER_EMAIL
SENDER_APP_PASS=REPLACE_APP_PASSWORD
CONTACT_RECEIVER_EMAIL=REPLACE_NOTIFICATION_RECIPIENT

# Explicit seed command from a trusted terminal only; never run during builds
# or function cold starts. Disable/remove bootstrap secrets after provisioning.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=REPLACE_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_STRONG_INITIAL_PASSWORD
ADMIN_NAME=Emtiaz Ahmed Emon
ADMIN_MOBILE_NUMBER=REPLACE_ADMIN_MOBILE

# Shared MongoDB-backed throttle records; TTL index added during implementation.
RATE_LIMIT_COLLECTION=portfolio_rate_limits

# Verification must use a separate database.
TEST_DB_URL=mongodb://127.0.0.1:27017/emon_portfolio_test
